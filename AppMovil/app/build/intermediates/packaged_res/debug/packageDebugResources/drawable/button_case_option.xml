<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#989CA7" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#858994" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <gradient android:angle="0" android:startColor="#B71C1C" android:endColor="#E53935" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="0" android:startColor="#2B0875" android:endColor="#5713BD" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
