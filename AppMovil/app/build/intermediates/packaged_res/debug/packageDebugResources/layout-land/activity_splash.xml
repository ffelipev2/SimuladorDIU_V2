<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sim_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="30dp"
            android:paddingTop="22dp"
            android:paddingEnd="30dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="28dp"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="260dp"
                    android:layout_height="72dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/logo_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/simgyo_logo" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/splash_tagline_background"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/splash_tagline"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/panel_background"
                android:elevation="5dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/splash_product_name"
                    android:textColor="#4210B1"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/splash_description"
                    android:textColor="#19354C"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/welcome_continue_hint"
                    android:textColor="#69708F"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/contactEmailText"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:autoLink="email"
                    android:background="@drawable/checklist_item_background"
                    android:contentDescription="@string/contact_email_description"
                    android:drawableStart="@drawable/ic_email_purple"
                    android:drawablePadding="7dp"
                    android:gravity="center"
                    android:linksClickable="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/contact_email"
                    android:textColor="#263851"
                    android:textColorLink="#4210B1"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/welcomeNextButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/button_primary"
                    android:backgroundTint="@null"
                    android:drawableEnd="@drawable/ic_arrow_right_primary"
                    android:drawablePadding="8dp"
                    android:stateListAnimator="@null"
                    android:text="@string/welcome_next"
                    android:textAllCaps="false"
                    android:textColor="@color/button_primary_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
