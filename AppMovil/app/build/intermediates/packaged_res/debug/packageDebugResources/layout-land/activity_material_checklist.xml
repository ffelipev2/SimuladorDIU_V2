<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/checklistRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sim_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:layout_weight="4"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="154dp"
                    android:layout_height="42dp"
                    android:contentDescription="@string/logo_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/simgyo_logo" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/checklist_eyebrow"
                    android:textColor="#42C878"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/checklist_title"
                    android:textColor="#0D2340"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/checklist_description"
                    android:textColor="#69708F"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="6"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/panel_background"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="@string/diu_icon_description"
                            android:src="@mipmap/ic_launcher" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/checklist_card_title"
                                android:textColor="#142841"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="@string/checklist_card_subtitle"
                                android:textColor="#757B94"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <CheckBox
                                android:id="@+id/material1Check"
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:background="@drawable/checklist_item_background"
                                android:buttonTint="@color/material_checkbox_tint"
                                android:gravity="center_vertical"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="@string/material_1"
                                android:textColor="#263851"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <CheckBox
                                android:id="@+id/material2Check"
                                android:layout_width="match_parent"
                                android:layout_height="58dp"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/checklist_item_background"
                                android:buttonTint="@color/material_checkbox_tint"
                                android:gravity="center_vertical"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="@string/material_2"
                                android:textColor="#263851"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <CheckBox
                                android:id="@+id/material3Check"
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/checklist_item_background"
                                android:buttonTint="@color/material_checkbox_tint"
                                android:gravity="center_vertical"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="@string/material_3"
                                android:textColor="#263851"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <CheckBox
                                android:id="@+id/material4Check"
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:background="@drawable/checklist_item_background"
                                android:buttonTint="@color/material_checkbox_tint"
                                android:gravity="center_vertical"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="@string/material_4"
                                android:textColor="#263851"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <CheckBox
                                android:id="@+id/material5Check"
                                android:layout_width="match_parent"
                                android:layout_height="58dp"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/checklist_item_background"
                                android:buttonTint="@color/material_checkbox_tint"
                                android:gravity="center_vertical"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="@string/material_5"
                                android:textColor="#263851"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <CheckBox
                                android:id="@+id/material6Check"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/checklist_item_background"
                                android:buttonTint="@color/material_checkbox_tint"
                                android:gravity="center_vertical"
                                android:minHeight="58dp"
                                android:paddingStart="8dp"
                                android:paddingTop="6dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="6dp"
                                android:text="@string/material_6"
                                android:textColor="#263851"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/materialProgressText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:gravity="center"
                        android:text="@string/material_progress_initial"
                        android:textColor="#6D7390"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/materialNextButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/button_primary"
                    android:backgroundTint="@null"
                    android:drawableEnd="@drawable/ic_arrow_right_primary"
                    android:drawablePadding="8dp"
                    android:enabled="false"
                    android:stateListAnimator="@null"
                    android:text="@string/checklist_next"
                    android:textAllCaps="false"
                    android:textColor="@color/button_primary_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
