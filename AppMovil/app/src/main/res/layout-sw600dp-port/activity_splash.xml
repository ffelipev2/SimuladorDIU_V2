<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sim_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="34dp"
        android:paddingTop="34dp"
        android:paddingEnd="34dp"
        android:paddingBottom="34dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.05"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="380dp"
                android:layout_height="106dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/logo_description"
                android:scaleType="fitCenter"
                android:src="@drawable/simgyo_logo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/splash_tagline_background"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/splash_tagline"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.78"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/splash_product_name"
                android:textColor="#4210B1"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/splash_description"
                android:textColor="#19354C"
                android:textSize="19sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/welcome_continue_hint"
                android:textColor="#69708F"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.67"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/contactEmailText"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:autoLink="email"
                android:background="@drawable/checklist_item_background"
                android:contentDescription="@string/contact_email_description"
                android:drawableStart="@drawable/ic_email_purple"
                android:drawablePadding="10dp"
                android:gravity="center"
                android:linksClickable="true"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/contact_email"
                android:textColor="#263851"
                android:textColorLink="#4210B1"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/welcomeNextButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/button_primary"
                android:backgroundTint="@null"
                android:drawableEnd="@drawable/ic_arrow_right_primary"
                android:drawablePadding="10dp"
                android:stateListAnimator="@null"
                android:text="@string/welcome_next"
                android:textAllCaps="false"
                android:textColor="@color/button_primary_text"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
