<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/checklistRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sim_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="26dp"
        android:paddingEnd="26dp"
        android:paddingBottom="28dp">

        <ImageView
            android:layout_width="210dp"
            android:layout_height="56dp"
            android:contentDescription="@string/logo_description"
            android:scaleType="fitCenter"
            android:src="@drawable/simgyo_logo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/checklist_eyebrow"
            android:textColor="#42C878"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/checklist_title"
            android:textColor="#0D2340"
            android:textSize="31sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/checklist_description"
            android:textColor="#69708F"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:background="@drawable/panel_background"
            android:elevation="5dp"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:contentDescription="@string/diu_icon_description"
                    android:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checklist_card_title"
                        android:textColor="#142841"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/checklist_card_subtitle"
                        android:textColor="#757B94"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <CheckBox
                android:id="@+id/material1Check"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="14dp"
                android:layout_weight="1"
                android:background="@drawable/checklist_item_background"
                android:buttonTint="@color/material_checkbox_tint"
                android:gravity="center_vertical"
                android:minHeight="62dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:text="@string/material_1"
                android:textColor="#263851"
                android:textSize="16sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/material2Check"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@drawable/checklist_item_background"
                android:buttonTint="@color/material_checkbox_tint"
                android:gravity="center_vertical"
                android:minHeight="62dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:text="@string/material_2"
                android:textColor="#263851"
                android:textSize="16sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/material3Check"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@drawable/checklist_item_background"
                android:buttonTint="@color/material_checkbox_tint"
                android:gravity="center_vertical"
                android:minHeight="62dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:text="@string/material_3"
                android:textColor="#263851"
                android:textSize="16sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/material4Check"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@drawable/checklist_item_background"
                android:buttonTint="@color/material_checkbox_tint"
                android:gravity="center_vertical"
                android:minHeight="62dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:text="@string/material_4"
                android:textColor="#263851"
                android:textSize="16sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/material5Check"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@drawable/checklist_item_background"
                android:buttonTint="@color/material_checkbox_tint"
                android:gravity="center_vertical"
                android:minHeight="62dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:text="@string/material_5"
                android:textColor="#263851"
                android:textSize="16sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/material6Check"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1.15"
                android:background="@drawable/checklist_item_background"
                android:buttonTint="@color/material_checkbox_tint"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="@string/material_6"
                android:textColor="#263851"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/materialProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/material_progress_initial"
                android:textColor="#6D7390"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/previousButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_primary"
            android:backgroundTint="@null"
            android:drawableStart="@drawable/ic_arrow_left_purple"
            android:drawablePadding="10dp"
            android:drawableTint="@android:color/white"
            android:text="Volver"
            android:textAllCaps="false"
            android:textColor="@color/button_primary_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/materialNextButton"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_primary"
            android:backgroundTint="@null"
            android:drawableEnd="@drawable/ic_arrow_right_primary"
            android:drawablePadding="10dp"
            android:enabled="false"
            android:stateListAnimator="@null"
            android:text="@string/checklist_next"
            android:textAllCaps="false"
            android:textColor="@color/button_primary_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
