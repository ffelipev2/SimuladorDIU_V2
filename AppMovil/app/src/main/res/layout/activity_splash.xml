<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sim_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="64dp"
            android:paddingEnd="28dp"
            android:paddingBottom="30dp">

            <ImageView
                android:layout_width="300dp"
                android:layout_height="84dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/logo_description"
                android:scaleType="fitCenter"
                android:src="@drawable/simgyo_logo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/splash_tagline_background"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/splash_tagline"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/splash_product_name"
                android:textColor="#4210B1"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/splash_description"
                android:textColor="#19354C"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/welcome_continue_hint"
                android:textColor="#69708F"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/contactEmailText"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:autoLink="email"
                android:background="@drawable/checklist_item_background"
                android:contentDescription="@string/contact_email_description"
                android:drawableStart="@drawable/ic_email_purple"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:linksClickable="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/contact_email"
                android:textColor="#263851"
                android:textColorLink="#4210B1"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/welcomeNextButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/button_primary"
                android:backgroundTint="@null"
                android:drawableEnd="@drawable/ic_arrow_right_primary"
                android:drawablePadding="8dp"
                android:stateListAnimator="@null"
                android:text="@string/welcome_next"
                android:textAllCaps="false"
                android:textColor="@color/button_primary_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
