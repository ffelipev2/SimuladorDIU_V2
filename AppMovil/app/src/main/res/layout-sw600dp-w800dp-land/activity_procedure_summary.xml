<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/procedureSummaryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sim_background">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/tablet_gutter"
            android:paddingTop="24dp"
            android:paddingEnd="@dimen/tablet_gutter"
            android:paddingBottom="28dp">
            <ImageView
                android:layout_width="164dp"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/logo_description"
                android:scaleType="fitCenter"
                android:src="@drawable/simgyo_logo" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="RESUMEN DEL PROCEDIMIENTO"
                android:textColor="#42C878"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Resultado registrado"
                android:textColor="#0D2340"
                android:textSize="29sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/panel_background"
                android:elevation="5dp"
                android:orientation="vertical"
                android:padding="22dp">
                <TextView
                    android:id="@+id/summaryMeasuredText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:textColor="#4210B1"
                    android:textSize="28sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/summaryDifferenceText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#263851"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="14dp" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="ESTADO DE LAS ACCIONES"
                android:textColor="#5E6480"
                android:textSize="12sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/summaryStatesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />
            <Button
                android:id="@+id/summaryFinishButton"
                android:layout_width="320dp"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/button_primary"
                android:backgroundTint="@null"
                android:text="Finalizar"
                android:textAllCaps="false"
                android:textColor="@color/button_primary_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_gravity="end" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
