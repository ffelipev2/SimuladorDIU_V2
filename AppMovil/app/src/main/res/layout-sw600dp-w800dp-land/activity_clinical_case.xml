<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clinicalCaseRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sim_background">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/tablet_gutter"
            android:paddingTop="24dp"
            android:paddingEnd="@dimen/tablet_gutter"
            android:paddingBottom="28dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="164dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/logo_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/simgyo_logo" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
                <ImageButton
                    android:id="@+id/caseSensorInfoButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/sensor_info_description"
                    android:padding="8dp"
                    android:src="@drawable/ic_info_purple" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="CASO CLÍNICO"
                android:textColor="#42C878"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Selecciona la profundidad uterina"
                android:textColor="#0D2340"
                android:textSize="29sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Conecta el simulador para habilitar un caso. Al elegirlo, el eje se centra y se posiciona según la profundidad indicada."
                android:textColor="#69708F"
                android:textSize="14sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/panel_background"
                android:elevation="5dp"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:id="@+id/caseConnectionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Conecta el dispositivo para continuar"
                    android:textColor="#69708F"
                    android:textSize="13sp" />
                <Button
                    android:id="@+id/caseBluetoothButton"
                    android:layout_width="320dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/button_primary"
                    android:backgroundTint="@null"
                    android:drawableStart="@drawable/ic_link_white"
                    android:drawablePadding="8dp"
                    android:text="Conectar por Bluetooth"
                    android:textAllCaps="false"
                    android:textColor="@color/button_primary_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_gravity="center_horizontal" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="OPCIONES DISPONIBLES"
                android:textColor="#5E6480"
                android:textSize="12sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/case5Button"
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_marginTop="0dp"
                    android:background="@drawable/button_case_option"
                    android:enabled="false"
                    android:text="Caso clínico 1  ·  5 cm"
                    android:textAllCaps="false"
                    android:textColor="@color/button_outline_text"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_weight="1"
                    android:gravity="center" />
                <Button
                    android:id="@+id/case8Button"
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_marginTop="0dp"
                    android:background="@drawable/button_case_option"
                    android:enabled="false"
                    android:text="Caso clínico 2  ·  8 cm"
                    android:textAllCaps="false"
                    android:textColor="@color/button_outline_text"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_marginStart="14dp" />
                <Button
                    android:id="@+id/case12Button"
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_marginTop="0dp"
                    android:background="@drawable/button_case_option"
                    android:enabled="false"
                    android:text="Caso clínico 3  ·  12 cm"
                    android:textAllCaps="false"
                    android:textColor="@color/button_outline_text"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_marginStart="14dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/caseSelectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Los casos se habilitarán al conectar el simulador."
                android:textColor="#69708F"
                android:textSize="13sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <FrameLayout
                    android:layout_width="280dp"
                    android:layout_height="56dp">
                    <Button
                        android:id="@+id/previousButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="0dp"
                        android:background="@drawable/button_primary"
                        android:backgroundTint="@null"
                        android:drawableStart="@drawable/ic_arrow_left_purple"
                        android:drawablePadding="8dp"
                        android:drawableTint="@android:color/white"
                        android:text="Volver"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </FrameLayout>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
                <FrameLayout
                    android:layout_width="320dp"
                    android:layout_height="56dp">
                    <Button
                        android:id="@+id/caseNextButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="0dp"
                        android:background="@drawable/button_primary"
                        android:backgroundTint="@null"
                        android:drawableEnd="@drawable/ic_arrow_right_primary"
                        android:drawablePadding="8dp"
                        android:enabled="false"
                        android:text="Continuar"
                        android:textAllCaps="false"
                        android:textColor="@color/button_primary_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
