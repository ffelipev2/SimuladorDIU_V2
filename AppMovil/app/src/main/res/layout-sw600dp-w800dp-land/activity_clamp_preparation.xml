<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clampPreparationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sim_background">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/tablet_gutter"
            android:paddingTop="24dp"
            android:paddingEnd="@dimen/tablet_gutter"
            android:paddingBottom="28dp">
            <ImageView
                android:layout_width="164dp"
                android:layout_height="44dp"
                android:contentDescription="@string/logo_description"
                android:scaleType="fitCenter"
                android:src="@drawable/simgyo_logo"
                android:layout_gravity="center_horizontal" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="32dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:text="PREPARACIÓN"
                        android:textColor="#42C878"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Pinzamiento y tracción"
                        android:textColor="#0D2340"
                        android:textSize="27sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/clamp_preparation_instruction"
                        android:textColor="#263851"
                        android:textSize="17sp"
                        android:layout_marginTop="20dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:background="@drawable/panel_background"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:text="@string/clamp_sound_question"
                        android:textColor="#142841"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <RadioGroup
                        android:id="@+id/clampSoundRadioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">
                        <RadioButton
                            android:id="@+id/clampSoundYes"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginEnd="28dp"
                            android:gravity="center_vertical"
                            android:text="Sí"
                            android:textColor="#263851"
                            android:textSize="16sp" />
                        <RadioButton
                            android:id="@+id/clampSoundNo"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:gravity="center_vertical"
                            android:text="No"
                            android:textColor="#263851"
                            android:textSize="16sp" />
                    </RadioGroup>
                    <TextView
                        android:id="@+id/clampTareStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:textColor="#4210B1"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                    <ProgressBar
                        android:id="@+id/clampTareProgress" style="?android:attr/progressBarStyleSmall"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="12dp"
                        android:indeterminate="true"
                        android:indeterminateTint="#4B12B5"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <FrameLayout
                    android:layout_width="280dp"
                    android:layout_height="56dp">
                    <Button
                        android:id="@+id/previousButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="0dp"
                        android:background="@drawable/button_primary"
                        android:backgroundTint="@null"
                        android:drawableStart="@drawable/ic_arrow_left_purple"
                        android:drawablePadding="8dp"
                        android:drawableTint="@android:color/white"
                        android:text="Volver"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </FrameLayout>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
                <FrameLayout
                    android:layout_width="320dp"
                    android:layout_height="56dp">
                    <Button
                        android:id="@+id/clampNextButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="0dp"
                        android:background="@drawable/button_primary"
                        android:backgroundTint="@null"
                        android:drawableEnd="@drawable/ic_arrow_right_primary"
                        android:drawablePadding="8dp"
                        android:enabled="false"
                        android:text="@string/welcome_next"
                        android:textAllCaps="false"
                        android:textColor="@color/button_primary_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
