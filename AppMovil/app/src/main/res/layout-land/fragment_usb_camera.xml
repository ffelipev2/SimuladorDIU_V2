<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sim_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="124dp"
                    android:layout_height="34dp"
                    android:contentDescription="Logo SimGyo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/simgyo_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ENDOSCOPIO"
                        android:textColor="#42C878"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Simulador DIU"
                        android:textColor="#4210B1"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/sensorInfoButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/sensor_info_description"
                    android:padding="8dp"
                    android:src="@drawable/ic_info_purple" />

                <TextView
                    android:id="@+id/connectionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/badge_disconnected"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="○  SIN CONEXIÓN"
                    android:textColor="#D73535"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="310dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1.12"
                    android:background="@drawable/panel_background"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FUERZA ACTUAL"
                                android:textColor="#69708F"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/currentWeightText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="0.00 g"
                                android:textColor="#4210B1"
                                android:textSize="36sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/zoneText"
                            android:layout_width="78dp"
                            android:layout_height="34dp"
                            android:gravity="center"
                            android:text="AZUL"
                            android:textColor="#2857D7"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lastWeightText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Último: 0.00 g"
                            android:textColor="#68708D"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.felipe.endoscopeviewer.ForceGaugeView
                        android:id="@+id/forceGauge"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:importantForAccessibility="yes" />

                    <TextView
                        android:id="@+id/bleStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxLines="2"
                        android:minHeight="32dp"
                        android:text="•  Conecta el dispositivo ESP32-S3"
                        android:textColor="#68708D"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/bluetoothButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/button_primary"
                            android:backgroundTint="@null"
                            android:drawableStart="@drawable/ic_link_white"
                            android:drawablePadding="5dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="5dp"
                            android:stateListAnimator="@null"
                            android:text="Conectar dispositivo"
                            android:textAllCaps="false"
                            android:textColor="@color/button_primary_text"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1">

                            <Button
                                android:id="@+id/tareButton"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/button_outline"
                                android:backgroundTint="@null"
                                android:drawableStart="@drawable/ic_scale_purple"
                                android:drawablePadding="4dp"
                                android:enabled="false"
                                android:minWidth="0dp"
                                android:paddingHorizontal="4dp"
                                android:stateListAnimator="@null"
                                android:text="Realizar tara"
                                android:textAllCaps="false"
                                android:textColor="@color/button_outline_text"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <ProgressBar
                                android:id="@+id/tareProgress"
                                style="?android:attr/progressBarStyleSmall"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="8dp"
                                android:indeterminate="true"
                                android:indeterminateTint="#4B12B5"
                                android:visibility="gone" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EXTENSIÓN DEL ÚTERO"
                            android:textColor="#5E6480"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/motorStatusText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:maxLines="1"
                            android:text="Conecta Bluetooth para controlar la extensión"
                            android:textColor="#737994"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginTop="3dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/motorLeftButton"
                            android:layout_width="0dp"
                            android:layout_height="55dp"
                            android:layout_weight="1"
                            android:background="@drawable/button_outline"
                            android:backgroundTint="@null"
                            android:drawableTop="@drawable/ic_arrow_left_purple"
                            android:drawablePadding="0dp"
                            android:enabled="false"
                            android:gravity="center"
                            android:minWidth="0dp"
                            android:padding="2dp"
                            android:stateListAnimator="@null"
                            android:text="Izquierda"
                            android:textAllCaps="false"
                            android:textColor="@color/button_outline_text"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/motorCenterButton"
                            android:layout_width="0dp"
                            android:layout_height="55dp"
                            android:layout_marginHorizontal="7dp"
                            android:layout_weight="1"
                            android:background="@drawable/button_primary"
                            android:backgroundTint="@null"
                            android:drawableTop="@drawable/ic_center_axis"
                            android:drawablePadding="0dp"
                            android:enabled="false"
                            android:gravity="center"
                            android:minWidth="0dp"
                            android:padding="2dp"
                            android:stateListAnimator="@null"
                            android:text="Centrar eje"
                            android:textAllCaps="false"
                            android:textColor="@color/button_primary_text"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/motorRightButton"
                            android:layout_width="0dp"
                            android:layout_height="55dp"
                            android:layout_weight="1"
                            android:background="@drawable/button_outline"
                            android:backgroundTint="@null"
                            android:drawableTop="@drawable/ic_arrow_right_purple"
                            android:drawablePadding="0dp"
                            android:enabled="false"
                            android:gravity="center"
                            android:minWidth="0dp"
                            android:padding="2dp"
                            android:stateListAnimator="@null"
                            android:text="Derecha"
                            android:textAllCaps="false"
                            android:textColor="@color/button_outline_text"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="0.88"
                    android:background="@drawable/panel_background"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CÁMARA EN VIVO"
                                android:textColor="#102641"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/statusText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Conecta una cámara mediante OTG"
                                android:textColor="#747B98"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/switchCameraButton"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:background="@drawable/tab_unselected_background"
                            android:backgroundTint="@null"
                            android:drawableStart="@drawable/ic_camera_blue"
                            android:enabled="false"
                            android:minWidth="0dp"
                            android:paddingHorizontal="7dp"
                            android:stateListAnimator="@null"
                            android:text="Sin otra cámara"
                            android:textAllCaps="false"
                            android:textColor="@color/button_outline_text"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/cameraViewContainer"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/camera_background"
                        android:clipToOutline="true">

                        <TextView
                            android:id="@+id/cameraStatusText"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:drawableTop="@drawable/ic_camera_blue"
                            android:drawablePadding="10dp"
                            android:gravity="center"
                            android:padding="12dp"
                            android:text="Esperando cámara USB"
                            android:textColor="#575E7D"
                            android:textSize="12sp" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/panel_background"
                android:elevation="5dp"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="REGISTROS DEL DISPOSITIVO"
                        android:textColor="#102641"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/clearHistoryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/tab_unselected_background"
                        android:backgroundTint="@null"
                        android:drawableStart="@drawable/ic_trash_white"
                        android:enabled="false"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:stateListAnimator="@null"
                        android:text="Limpiar"
                        android:textAllCaps="false"
                        android:textColor="@color/button_outline_text"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/historyTabButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/tab_selected_background"
                        android:backgroundTint="@null"
                        android:drawableStart="@drawable/ic_history_blue"
                        android:stateListAnimator="@null"
                        android:text="Historial"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/thresholdsTabButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/tab_unselected_background"
                        android:backgroundTint="@null"
                        android:drawableStart="@drawable/ic_thresholds_gray"
                        android:stateListAnimator="@null"
                        android:text="Umbrales"
                        android:textAllCaps="false"
                        android:textColor="#4B12B5"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/historySelectedText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="2"
                    android:text="Sin registros. Presiona y suelta el dispositivo."
                    android:textColor="#747B98"
                    android:textSize="10sp" />

                <LinearLayout
                    android:id="@+id/historyContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="130dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/historyList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/thresholdsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="130dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/thresholdsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
